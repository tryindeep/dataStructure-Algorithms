
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run C++",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "g++ -std=c++17 -O2 -Wall -Wextra \"${workspaceFolder}/demo.cpp\" -o \"${workspaceFolder}/demo\" && \"${workspaceFolder}/demo\" < \"${workspaceFolder}/input.txt\" > \"${workspaceFolder}/output.txt\" && cat \"${workspaceFolder}/output.txt\""
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
